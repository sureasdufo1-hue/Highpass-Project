NODE_ENV=production
HIPASS_ENV=staging
PORT=3000
HIPASS_STORE=postgres

# Staging must use a dedicated non-production database.
# Store the real value in an external Secret Manager, not in Git.
DATABASE_URL=replace-with-external-secret-provider-reference
POSTGRES_SSLMODE=verify-full
POSTGRES_SSL_CA_FILE=/run/secrets/staging_db_ca

# Staging must not use DEVELOPMENT_MOCK.
AUTH_MODE=OIDC
OIDC_DISCOVERY_URL=https://replace-with-test-idp/.well-known/openid-configuration
JWT_ISSUER=https://replace-with-test-idp
JWT_AUDIENCE=hipass-staging-api
JWT_PUBLIC_KEY=replace-with-mounted-or-provider-value
HIPASS_INTERNAL_SERVICE_TOKEN=replace-with-external-secret-provider-reference

# External secret and key providers.
SECRET_PROVIDER=EXTERNAL
SECRET_PROVIDER_NAME=replace-with-aws-secrets-manager-or-azure-key-vault-or-vault
KEY_PROVIDER=KMS
KMS_PROVIDER_NAME=replace-with-non-production-kms
DICOM_TOKEN_TTL_MINUTES=5

# Gateway and DICOMweb.
ORTHANC_REST_URL=https://replace-with-staging-orthanc-mtls
ORTHANC_TLS_CA_FILE=/run/secrets/staging_mtls_ca
ORTHANC_TLS_CERT_FILE=/run/secrets/staging_gateway_client_cert
ORTHANC_TLS_KEY_FILE=/run/secrets/staging_gateway_client_key
ORTHANC_TLS_REJECT_UNAUTHORIZED=1
OHIF_PUBLIC_URL=https://replace-with-staging-viewer-url

# Audit and pseudonym keys must come from external providers.
AUDIT_HASH_SECRET=replace-with-external-secret-provider-reference
PSEUDONYM_HMAC_SECRET=replace-with-kms-or-secret-provider-reference

# Human notification endpoint must be non-production and must not receive PHI.
ALERT_HUMAN_CHANNEL=replace-with-email-slack-or-teams
ALERT_WEBHOOK_SECRET=replace-with-external-secret-provider-reference
