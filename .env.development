NODE_ENV=development
PORT=3000
HIPASS_CONTROL_HOST_PORT=3000
HIPASS_STORE=postgres

POSTGRES_DB=hipass
POSTGRES_USER=hipass_app
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgres://hipass_app:replace-with-local-development-password@postgres:5432/hipass

AUTH_MODE=DEVELOPMENT_MOCK
HIPASS_INTERNAL_SERVICE_TOKEN=replace-with-local-internal-service-token
JWT_ISSUER=hipass-test
JWT_AUDIENCE=hipass-api
TEST_JWT_SECRET=replace-with-local-test-jwt-secret

DICOM_TOKEN_SECRET=replace-with-local-32-byte-minimum-secret
DICOM_TOKEN_TTL_MINUTES=5

ORTHANC_REST_URL=http://hospital-a-orthanc:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
OHIF_PUBLIC_URL=http://localhost:3001

AUDIT_HASH_SECRET=replace-with-local-audit-hash-secret
PSEUDONYM_HMAC_SECRET=replace-with-local-pseudonym-secret
