{
  "name": "hipass-platform-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "C-MIX/HiPass patient-consent based medical imaging exchange MVP simulator.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "node src/server.js",
    "start:json": "node src/server.js",
    "start:postgres": "node scripts/start-postgres.js",
    "test": "node --test",
    "test:privacy": "node --test test/privacy-filter.test.js",
    "privacy:db-gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/privacy-db-gate.ps1",
    "privacy:model-smoke": "node scripts/privacy-model-smoke.js",
    "security:secrets": "node scripts/security-secret-scan.js",
    "security:network": "node scripts/security-network-check.js",
    "security:readiness": "node scripts/production-readiness-check.js",
    "security:gate": "node scripts/security-gate.js",
    "security:container": "node scripts/container-vulnerability-gate.js",
    "security:container:scan": "node scripts/container-scan.js",
    "ops:expiry": "node scripts/operations-expiry-check.js",
    "ops:monitor": "node scripts/ops-monitoring-check.js",
    "e2e:https": "node scripts/e2e-integration-test.js",
    "phr:verify-mapping": "node scripts/verify-phr-imaging-mapping.js",
    "compliance:evidence": "node scripts/collect-compliance-evidence.js",
    "test:cert-fixtures": "node scripts/cert-fixture-check.js",
    "test:cert-rollback": "node scripts/rehearse-dev-cert-rollback.js",
    "test:mtls-negative": "node scripts/mtls-negative-check.js",
    "mvp:preflight": "node scripts/mvp-verify.js --preflight",
    "mvp:start": "node scripts/mvp-verify.js --start",
    "mvp:readiness": "node scripts/mvp-verify.js --readiness",
    "mvp:demo": "node scripts/e2e-integration-test.js",
    "mvp:negative": "node scripts/mtls-negative-check.js",
    "mvp:verify": "node scripts/mvp-verify.js",
    "mvp:finalize": "node scripts/phase5-final-gate.js",
    "mvp:cleanup": "node scripts/mvp-verify.js --cleanup",
    "staging:smoke": "node scripts/staging-smoke-test.js",
    "sbom": "node scripts/generate-sbom.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
