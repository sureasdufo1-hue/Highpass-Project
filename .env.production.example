NODE_ENV=production
PORT=3000
HIPASS_STORE=postgres

POSTGRES_DB=hipass
POSTGRES_USER=hipass_app
POSTGRES_PASSWORD=replace-with-secret-manager-value
DATABASE_URL=postgres://hipass_app:replace-with-secret-manager-value@postgres:5432/hipass

# Production must not use DEVELOPMENT_MOCK.
AUTH_MODE=OIDC
JWT_ISSUER=https://replace-with-hospital-or-platform-issuer
JWT_AUDIENCE=hipass-api
JWT_PUBLIC_KEY=replace-with-pem-public-key-or-mounted-secret
HIPASS_INTERNAL_SERVICE_TOKEN=replace-with-secret-manager-value

DICOM_TOKEN_SECRET=replace-with-secret-manager-value
DICOM_TOKEN_TTL_MINUTES=5

EDGE_TLS_CERT_FILE=/run/secrets/hipass_edge_tls_cert
EDGE_TLS_KEY_FILE=/run/secrets/hipass_edge_tls_key

ORTHANC_REST_URL=https://hospital-a-orthanc-mtls:8443
ORTHANC_TLS_CA_FILE=/run/secrets/hipass_mtls_ca
ORTHANC_TLS_CERT_FILE=/run/secrets/hipass_gateway_client_cert
ORTHANC_TLS_KEY_FILE=/run/secrets/hipass_gateway_client_key
ORTHANC_TLS_REJECT_UNAUTHORIZED=1
OHIF_PUBLIC_URL=https://replace-with-viewer-url

AUDIT_HASH_SECRET=replace-with-secret-manager-value
PSEUDONYM_HMAC_SECRET=replace-with-secret-manager-or-kms-value
