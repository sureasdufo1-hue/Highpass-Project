PORT=3000
HIPASS_STORE=postgres

POSTGRES_DB=hipass
POSTGRES_USER=hipass_app
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgres://hipass_app:replace-with-local-development-password@postgres:5432/hipass

# DICOMweb access tokens
# Use a long random value in local/prod env files. Do not commit real secrets.
DICOM_TOKEN_SECRET=replace-with-random-32-byte-secret-minimum-32-bytes
DICOM_TOKEN_TTL_MINUTES=5
ORTHANC_REST_URL=http://hospital-a-orthanc:8042

# Rule-based anomaly detection thresholds
HIPASS_BULK_ACCESS_WINDOW_MINUTES=5
HIPASS_BULK_ACCESS_THRESHOLD=50
HIPASS_REPEATED_FAILURE_WINDOW_MINUTES=10
HIPASS_REPEATED_FAILURE_THRESHOLD=20
HIPASS_EXPIRED_TOKEN_WINDOW_MINUTES=10
HIPASS_EXPIRED_TOKEN_THRESHOLD=10
HIPASS_UNUSUAL_DOWNLOAD_WINDOW_MINUTES=60
HIPASS_UNUSUAL_DOWNLOAD_THRESHOLD=5
HIPASS_UNUSUAL_DOWNLOAD_START_HOUR=0
HIPASS_UNUSUAL_DOWNLOAD_END_HOUR=6
