PORT=3000
HIPASS_CONTROL_HOST_PORT=3300
HIPASS_STORE=postgres
NODE_ENV=development

POSTGRES_DB=hipass
POSTGRES_USER=hipass_app
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgres://hipass_app:replace-with-local-development-password@postgres:5432/hipass

# DICOMweb access tokens
# Use a long random value in local/prod env files. Do not commit real secrets.
DICOM_TOKEN_SECRET=replace-with-random-32-byte-secret-minimum-32-bytes
DICOM_TOKEN_TTL_MINUTES=5
# Dedicated metadata-only A Gateway contract; optional until distributed wiring.
# Generate a DIFFERENT random credential from internal/privacy tokens, outside Git.
HIPASS_DATA_PLANE_SERVICE_TOKEN=
HIPASS_DATA_PLANE_SOURCE_HOSPITAL_ID=HOSP-A
CAPSTONE_PATIENT_SELF_VIEW_GATEWAY=0
CAPSTONE_PATIENT_IMAGE_ENCRYPTION_REQUIRED=0
CAPSTONE_B_PATIENT_KEY_RELEASE_TOKEN_FILE=
PATIENT_DATA_PLANE_SERVICE_TOKEN_FILE=
PATIENT_DATA_PLANE_SOURCE_HOSPITAL_ID=
HIPASS_DATA_PLANE_PUBLIC_BASE_URL=https://hospital-a.demo.test
# REQUIRED on cloud Control API: forbids legacy image/import/export paths.
# Leave 0 only for the existing single-host development demo.
HIPASS_CONTROL_PLANE_ONLY=0
# One-time QR transfer ticket (opaque nonce). Plaintext nonce is never stored.
HIPASS_TICKET_TTL_MINUTES=10
# Public origin used to build the QR deep link: {HIPASS_PUBLIC_BASE_URL}/t/{nonce}
HIPASS_PUBLIC_BASE_URL=https://localhost:3443
ORTHANC_REST_URL=http://hospital-a-orthanc:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
OHIF_PUBLIC_URL=http://localhost:3001
AUDIT_HASH_SECRET=replace-with-random-audit-hash-secret
PSEUDONYM_HMAC_SECRET=replace-with-random-pseudonym-secret

# Authentication
# DEVELOPMENT_MOCK is for local PoC only. Production must use a real IdP-backed mode.
AUTH_MODE=DEVELOPMENT_MOCK
HIPASS_INTERNAL_SERVICE_TOKEN=replace-with-random-internal-service-token
# Optional Privacy-only credential: HIPASS_PRIVACY_SERVICE_TOKEN.
# Omit when disabled; do not set an empty value or commit a real token.
# Provision a distinct CSPRNG-generated 32-byte base64url token through secret management.
# When enabled, the shared token loses privacy:inspect; registry requester must be privacy-service.
# Optional HIPASS_PRIVACY_REQUEST_TIMEOUT_MS: total Privacy handler budget, default 30000 (1..60000).
JWT_ISSUER=hipass-test
JWT_AUDIENCE=hipass-api
JWT_PUBLIC_KEY=
TEST_JWT_SECRET=replace-with-random-test-jwt-secret

# Rule-based anomaly detection thresholds
HIPASS_BULK_ACCESS_WINDOW_MINUTES=5
HIPASS_BULK_ACCESS_THRESHOLD=50
HIPASS_REPEATED_FAILURE_WINDOW_MINUTES=10
HIPASS_REPEATED_FAILURE_THRESHOLD=20
HIPASS_EXPIRED_TOKEN_WINDOW_MINUTES=10
HIPASS_EXPIRED_TOKEN_THRESHOLD=10
HIPASS_UNUSUAL_DOWNLOAD_WINDOW_MINUTES=60
HIPASS_UNUSUAL_DOWNLOAD_THRESHOLD=5
HIPASS_UNUSUAL_DOWNLOAD_START_HOUR=0
HIPASS_UNUSUAL_DOWNLOAD_END_HOUR=6

# Research de-identification policy
# Opt-in fixed synthetic CT/MR catalog registration (capstone TEST/Postgres only)
HIPASS_CAPSTONE_PHANTOM_CATALOG=0
# Patient self-view Grant HTTP is off until explicit authority registration,
# dedicated nonowner writer privileges/migrations033-035 and single-writer review.
HIPASS_CAPSTONE_PATIENT_GRANTS=0
HIPASS_CAPSTONE_SINGLE_WRITER=0
HIPASS_PATIENT_AUTHORITY_DATABASE_URL=
HIPASS_PATIENT_SELF_VIEW_SERVICE_TOKEN=
HIPASS_PATIENT_KEY_RELEASE_SERVICE_TOKEN=
HIPASS_CAPSTONE_PATIENT_KEY_RELEASE=0
HIPASS_PATIENT_KEY_VAULT_KEY_ID=
HIPASS_DEID_DATE_POLICY=YEAR_ONLY
HIPASS_DEID_UID_POLICY=REGENERATE_UID
HIPASS_DEID_K_ANONYMITY_THRESHOLD=5
HIPASS_DEID_MIN_DATASET_SIZE=20
HIPASS_DEID_BLOCK_HIGH_RISK_PIXEL_DATA=true
