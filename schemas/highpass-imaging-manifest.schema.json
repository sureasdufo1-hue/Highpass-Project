{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highpass.example/schemas/highpass-imaging-manifest.schema.json",
  "title": "Highpass Protected Imaging Manifest",
  "type": "object",
  "required": ["schemaVersion", "packageId", "transferId", "consentId", "patientRef", "sourceInstitution", "destinationInstitution", "purpose", "scope", "objects", "instanceCount", "frameCount", "packageHash", "manifestHash", "chunkHashes", "encryption", "createdAt", "expiresAt", "state"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "packageId": {"type": "string", "pattern": "^pkg_[A-Za-z0-9_-]{16,80}$"},
    "transferId": {"type": "string", "pattern": "^trf_[A-Za-z0-9_-]{16,80}$"},
    "consentId": {"type": "string", "maxLength": 96},
    "patientRef": {"type": "string", "pattern": "^pat_[A-Za-z0-9_-]{16,96}$"},
    "sourceInstitution": {"type": "string", "maxLength": 96},
    "destinationInstitution": {"type": "string", "maxLength": 96},
    "purpose": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "objects": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"$ref": "#/$defs/object"}},
    "instanceCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "frameCount": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "packageHash": {"$ref": "#/$defs/hash"},
    "manifestHash": {"$ref": "#/$defs/hash"},
    "chunkHashes": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"$ref": "#/$defs/hash"}},
    "encryption": {"type": "object", "required": ["algorithm", "version", "keyEnvelopeRefs"], "properties": {"algorithm": {"const": "A256GCM"}, "version": {"const": "enc-v1"}, "keyEnvelopeRefs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 96}}}, "additionalProperties": false},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["CREATED", "ENCRYPTED", "DOWNLOADING", "STORED_ON_DEVICE", "READY_FOR_HANDOFF", "HANDOFF_PENDING", "UPLOADING", "RECEIVED", "VERIFIED", "VIEWED", "IMPORTED", "EXPIRED", "REVOKED", "DELETED", "FAILED"]}
  },
  "$defs": {
    "hash": {"type": "string", "contentEncoding": "base64url", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "scope": {"type": "object", "required": ["studyRefs", "actions"], "properties": {"studyRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 96}}, "seriesRefs": {"type": "array", "items": {"type": "string", "maxLength": 96}}, "instanceRefs": {"type": "array", "items": {"type": "string", "maxLength": 96}}, "frameRanges": {"type": "array", "items": {"type": "object", "required": ["instanceRef", "start", "end"], "properties": {"instanceRef": {"type": "string"}, "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false}}, "actions": {"type": "array", "items": {"enum": ["VIEW", "DOWNLOAD", "MOBILE_STORE", "MOBILE_HANDOFF", "PACS_IMPORT"]}, "uniqueItems": true}}, "additionalProperties": false},
    "object": {"type": "object", "required": ["studyRef", "seriesRef", "instanceRef", "size", "objectHash", "chunkStart", "chunkEnd"], "properties": {"studyRef": {"type": "string"}, "seriesRef": {"type": "string"}, "instanceRef": {"type": "string"}, "frames": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}, "size": {"type": "integer", "minimum": 1}, "objectHash": {"$ref": "#/$defs/hash"}, "chunkStart": {"type": "integer", "minimum": 0}, "chunkEnd": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
